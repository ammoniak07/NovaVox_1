<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette reprise de gui/style.css (thème sombre par défaut) pour
         garder une identité visuelle cohérente avec la version Python. -->
    <Color x:Key="BgColor">#0A0E14</Color>
    <Color x:Key="PanelColor">#121822</Color>
    <Color x:Key="PanelAltColor">#1A2230</Color>
    <Color x:Key="BorderColor">#263140</Color>
    <Color x:Key="TextColor">#DBE4EE</Color>
    <Color x:Key="MutedColor">#7C8A9C</Color>
    <Color x:Key="AccentColor">#2DD4FF</Color>
    <Color x:Key="AmberColor">#FFB020</Color>
    <Color x:Key="DangerColor">#FF4D5E</Color>
    <Color x:Key="SuccessColor">#35E0A1</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <Style TargetType="Window" x:Key="BaseWindowStyle">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</ResourceDictionary>
