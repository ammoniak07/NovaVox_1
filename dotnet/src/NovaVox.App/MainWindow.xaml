<Window x:Class="NovaVox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="NovaVox"
        Width="1000" Height="930">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,10">
                <TextBlock Text="NOVAVOX" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <!-- Contenu principal (liste de commandes + panneaux de réglages) :
             placeholder en attendant la reconstruction native de l'interface
             (voir tâche #11). -->
        <Grid Grid.Row="1" Margin="16">
            <TextBlock Text="Interface en construction — reconstruction native en cours."
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
