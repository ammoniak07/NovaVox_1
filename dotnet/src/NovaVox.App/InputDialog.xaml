<Window x:Class="NovaVox.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="NovaVox" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="360" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Width="80" Click="Cancel_Click" />
            <Button Content="OK" Width="80" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
